# Smart Notebook – Beispielkonfiguration
#
# Kopieren nach `.env` im Repository-Root und mit echten Werten füllen.
# `.env` ist gitignored; diese Datei ist die einzige eingecheckte Liste
# dessen, was gesetzt sein muss. Geladen wird sie über
# `smart_notebook/config.py::_load_local_env()` mit `os.environ.setdefault`,
# Prozess-/Shell-Umgebungsvariablen gewinnen also immer über `.env`.
#
# Variablen ohne sinnvollen Fallback (LLM_URL, EMBEDDING_URL, STT_URL,
# POSTGRES_HOST, POSTGRES_PASSWORD) sind Pflicht: fehlen sie, bricht der
# Start mit einem RuntimeError ab, der die fehlenden Namen auflistet, statt
# den Server stillschweigend gegen eine leere Adresse laufen zu lassen.

# --- LLM / Embedding / STT (Pflicht: LLM_URL, EMBEDDING_URL, STT_URL) ------
# Vollständige Endpoint-URLs der jeweiligen lokalen Inferenzserver.
LLM_URL=http://localhost:8080/v1/chat/completions
LLM_MODEL=CapybaraLM
EMBEDDING_URL=http://localhost:8181/v1/embeddings
STT_URL=http://localhost:9000/v1/audio/transcriptions

# --- Postgres (Pflicht: POSTGRES_HOST, POSTGRES_PASSWORD) ------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smart_notebook
POSTGRES_USER=smart_notebook
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Client-Kontrakt (ESP32/Android) ---------------------------------------
# Secret zum Signieren/Prüfen der Geräte-Credentials. Leer = kein gültiges
# Gerät kann sich authentisieren.
CLIENT_DEVICE_AUTH_SECRET=change-me-32-bytes-minimum-random-hex
# Bearer-Token für alles unter /api/, das nicht der Client-Kontrakt ist
# (Notes, Claims, Tasks, Lists, Artifacts, CalDAV, Worker-Trigger). Leer
# sperrt diese Routen vollständig, statt sie zu öffnen.
CLIENT_OPERATOR_TOKEN=change-me-32-bytes-minimum-random-hex
# true/false: erzwingt Geräte-Authentisierung auf /api/client/*.
CLIENT_DEVICE_AUTH_REQUIRED=false
# Maximale Chunkgröße für Audio-Uploads in Byte (64 KiB – 16 MiB).
CLIENT_AUDIO_MAX_CHUNK_BYTES=2097152
# Ziel-Segmentlänge für Audio-Uploads in Millisekunden (1000 – 60000).
CLIENT_AUDIO_SEGMENT_TARGET_MS=10000
# Timeout für Client-Requests in Sekunden (5 – 300).
CLIENT_REQUEST_TIMEOUT_SECONDS=60
# Maximales Alter des Dashboard-Caches in Sekunden (300 – 604800).
CLIENT_DASHBOARD_CACHE_MAX_AGE_SECONDS=7200
# Kommagetrennte Liste erlaubter CORS-Origins, leer = keine.
CLIENT_CORS_ORIGINS=
# ready/degraded/maintenance; jeder andere Wert fällt auf degraded zurück.
CLIENT_SERVER_STATUS=ready
# Freitext, den Clients bei degraded/maintenance anzeigen (max. 500 Zeichen).
CLIENT_SERVER_STATUS_MESSAGE=

# --- Nextcloud / CalDAV -----------------------------------------------------
NEXTCLOUD_URL=https://cloud.example.com
NEXTCLOUD_USERNAME=change-me
NEXTCLOUD_APP_PASSWORD=change-me
NEXTCLOUD_TASK_CALENDAR=notizbuch
# Timeout für CalDAV-Requests in Sekunden (5 – 120).
CALDAV_TIMEOUT_SECONDS=30
# true/false: TLS-Zertifikatsprüfung für CalDAV.
CALDAV_VERIFY_TLS=true
# Sync-Intervall in Sekunden (30 – 86400).
CALDAV_SYNC_INTERVAL_SECONDS=300
# Anzahl aufeinanderfolgender Fehlschläge bis zur Alarmierung (1 – 100).
CALDAV_ALERT_AFTER_FAILURES=3

# --- ntfy (Fehlerbenachrichtigung) -----------------------------------------
NTFY_SERVER_URL=
NTFY_ERROR_TOPIC=
NTFY_ACCESS_TOKEN=
# Timeout für ntfy-Requests in Sekunden (5 – 60).
NTFY_TIMEOUT_SECONDS=15

# --- Audio-Retention ---------------------------------------------------------
# Verzeichnis für zwischengespeicherte Audiodateien; Default liegt unter
# <Repository-Root>/data/audio, falls nicht gesetzt.
AUDIO_RETENTION_CACHE_DIR=
# Aufbewahrungsdauer für Audiodateien in Tagen.
AUDIO_RETENTION_DAYS=7
# Aufbewahrungsdauer für Systemlogs in Stunden (1 – 48).
SYSTEM_LOG_RETENTION_HOURS=48

# --- Wissens- und Themenerkennung (Konfidenz-/Ähnlichkeitsschwellen 0–1) ---
TOPIC_NEW_MIN_CONFIDENCE=0.90
TOPIC_LINK_MIN_CONFIDENCE=0.82
TOPIC_LIVE_MIN_CONFIDENCE=0.85
SEMANTIC_EXAMPLE_MIN_SIMILARITY=0.86
# Marge 0–2.
SEMANTIC_EXAMPLE_MIN_MARGIN=0.08
NIGHTLY_KNOWLEDGE_SEMANTIC_MIN_SIMILARITY=0.82
NIGHTLY_TOPIC_SEMANTIC_MIN_SIMILARITY=0.80
# Cache-/Ergebnis-TTL in Stunden (1 – 24).
RETRIEVAL_CACHE_TTL_HOURS=24
REFERENCE_RESULT_TTL_HOURS=24
REFERENCE_STRONG_CONFIDENCE=0.82
REFERENCE_SUPPORTING_CONFIDENCE=0.72
REFERENCE_AMBIGUITY_MARGIN=0.08
NOTE_TO_FACT_MIN_EVIDENCE_SCORE=0.80
